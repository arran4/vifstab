Canonical sysfs/udev enrichment, alias resolution and incomplete observations.
No fixture is a real device, and device/image openers must never be called.
-- scenarios.json --
[
  {"Name":"path","Reference":"/dev/vda","Expected":"expected/full.txt"},
  {"Name":"uuid","Reference":"UUID=fixture-disk","Expected":"expected/full.txt"},
  {"Name":"unreadable-size","Reference":"/dev/vda","Expected":"expected/partial.txt","Faults":{"read:/sys/class/block/vda/size":"permission"}},
  {"Name":"unknown-parent","Reference":"/dev/vda","Expected":"expected/uncorrelated.txt","Faults":{"readlink:/sys/class/block/vda2":"permission"}}
]
-- links.json --
{
  "/sys/class/block/vda1":"../../devices/virtual/block/vda/vda1",
  "/sys/class/block/vda2":"../../devices/virtual/block/vda/vda2",
  "/dev/disk/by-uuid/fixture-disk":"../../vda"
}
