-- input/etc/fstab --
/root/crypt /mnt/crypt ecryptfs ecryptfs_sig,ecryptfs_key_bytes=abc,ecryptfs_passthrough=yes,ecryptfs_enable_filename_crypto=z,verbosity=2,passphrase_passwd_file=/missing/file.txt,openssl_keyfile=/missing/key.pem,openssl_passwd_file=/missing/pass.txt 0 0
-- cache --
file_exists:/missing/file.txt=false
file_exists:/missing/key.pem=false
file_exists:/missing/pass.txt=false
