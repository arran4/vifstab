-- options.txt --
rule=fstab_permissions
format=level_prefix
-- input/etc/fstab --
LABEL=root / ext4 defaults 0 1
-- cache --
fstab_path=/etc/fstab
fstab_mode=0644
fstab_uid=1000
fstab_gid=1000
-- issues --
Warning: fstab target '/etc/fstab' is owned by uid 1000, expected root (0); recommended root:root ownership
