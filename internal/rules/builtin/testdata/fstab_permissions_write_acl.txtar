-- options.txt --
rule=fstab_permissions
format=level_prefix
-- input/etc/fstab --
LABEL=root / ext4 defaults 0 1
-- cache --
fstab_path=/etc/fstab
fstab_mode=0644
fstab_uid=0
fstab_gid=0
fstab_write_acl=true
-- issues --
Warning: fstab target '/etc/fstab' has ACL granting write access to non-root users; recommended removing write ACL
