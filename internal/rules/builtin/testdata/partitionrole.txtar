test: partition role linting
options:
  rules:
    - PartitionRole
-- input/etc/fstab --
# Valid case
UUID=1111-2222 /boot/efi vfat defaults 1 2

# Invalid case 1: /boot with ESP type but ext4
LABEL=gentooboot /boot ext4 defaults 1 2

# Invalid case 2: /efi with non-ESP type and vfat
UUID=8F53-C3B9 /efi vfat defaults 1 2

-- input/proc/filesystems --
nodev	sysfs
nodev	tmpfs
nodev	proc
	ext4
	vfat
-- cache --
proc_filesystems=sysfs,tmpfs,proc,ext4,vfat
block_devices=[{"path":"/dev/sda1","fstype":"ext4","parttype":"c12a7328-f81f-11d2-ba4b-00a0c93ec93b","label":"gentooboot"},{"path":"/dev/sda2","fstype":"vfat","parttype":"ebd0a0a2-b9e5-4433-87c0-68b6b72699c7","uuid":"8F53-C3B9","mountpoints":["/efi"]}]
-- options.json --
{
  "rules": ["PartitionRole"]
}
-- expected/validationerrors.txt --
GPT partition type is EFI System Partition (ESP) but filesystem is not FAT
/boot is typed as ESP but a distinct FAT EFI partition is present
FAT filesystem mounted at EFI mountpoint but GPT partition type is not ESP
