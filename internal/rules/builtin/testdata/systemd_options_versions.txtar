Version gates use explicit target observations, not kernel/distro/PID1 guesses.
-- options.txt --
rule=systemd-options
format=level_prefix
-- cache --
systemd_version=256
-- input --
UUID=example /data ext4 x-systemd.wants-mounts-for=/other,x-systemd.wants=other.mount,x-systemd.validatefs,x-systemd.graceful-option=nosymfollow 0 2
-- issues --
