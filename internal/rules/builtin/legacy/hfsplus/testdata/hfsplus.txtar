-- input/etc/fstab --
# Valid hfsplus options
/dev/sda1 /mnt/1 hfsplus defaults,creator=MAC?,type=TEXT,uid=1000,gid=1000,umask=022,session=1,part=2,decompose,nodecompose,force,nls=utf8 0 0
/dev/sda4 /mnt/4 hfsplus dir_umask=077,file_umask=022,quota,noquota 0 0

# Invalid hfsplus options
/dev/sda2 /mnt/2 hfsplus creator,type=TEX,uid=root,gid=-1,umask=999,session=abc,part=xyz,nls=unknown 0 0
/dev/sda5 /mnt/5 hfsplus dir_umask=999,file_umask=888,quota=1,noquota=0 0 0

# Unrecognized option
/dev/sda3 /mnt/3 hfsplus invalidopt 0 0

-- input/etc/passwd --
root:x:0:0:root:/root:/bin/bash
user:x:1000:1000:user:/home/user:/bin/bash

-- input/etc/group --
root:x:0:
user:x:1000:

