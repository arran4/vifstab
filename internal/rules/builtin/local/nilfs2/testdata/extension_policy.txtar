Known malformed extensions block; future x-/X-/systemd keys stay unverified and
nonblocking. Valid documented userspace shapes work in this actual rule.
-- cache --
proc_filesystems=nilfs2
-- kernel --
6.5.0
-- input --
example /example nilfs2 X-mount.mkdir=bad,X-mount.noloop=,X-mount.subdir,x-future.thing=value,X-mount.noloopp,x-systemd.future= 0 0
example /example nilfs2 X-mount.mkdir=0755,x-mount.mkdir,X-mount.noloop,X-mount.subdir=relative 0 0
