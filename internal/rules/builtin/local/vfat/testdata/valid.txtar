-- input/etc/fstab --
# Valid vfat options
/dev/sda1 /mnt vfat uid=1000,gid=1000,umask=022,dmask=022,fmask=133,allow_utime=022,codepage=437,iocharset=utf8,utf8=1,uni_xlate=yes,nonumtail=true,usefree,quiet,check=s,shortname=mixed,tz=UTC,time_offset=120,showexec,debug,sys_immutable,flush,rodir,errors=continue,discard,nfs=stale_rw,dos1xfloppy=1 0 0
/dev/sdb1 /mnt2 vfat check=r,shortname=win95,errors=remount-ro,nfs=nostale_ro,dos1xfloppy=0 0 0
/dev/sdc1 /mnt3 vfat check=n,shortname=winnt,errors=panic 0 0
/dev/sdd1 /mnt4 vfat shortname=lower 0 0

