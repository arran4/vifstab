test: format and linux_fs test

-- description.txt --
Ensures we correctly parse and lint fstab using the runner pattern.
-- input/etc/fstab --
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
/dev/sda1       /               ext4    defaults        0       1
/dev/sda2       none            none    sw              0       0
/dev/sda3       /mnt            unknown defaults        0       2
-- input/proc/filesystems --
nodev	sysfs
nodev	rootfs
nodev	ramfs
nodev	bdev
nodev	proc
nodev	cpuset
nodev	cgroup
nodev	cgroup2
nodev	tmpfs
nodev	devtmpfs
nodev	configfs
nodev	debugfs
nodev	tracefs
nodev	securityfs
nodev	sockfs
nodev	bpf
nodev	pipefs
nodev	hugetlbfs
nodev	devpts
	ext3
	ext2
	ext4
	squashfs
	vfat
nodev	ecryptfs
	fuseblk
nodev	fuse
nodev	fusectl
nodev	mqueue
nodev	pstore
nodev	autofs
-- options.json --
{
  "rules": ["format", "linux_fs"]
}
-- expected/output.txt --
Validation issues found:
 - [error] Filesystem type for swap must be 'swap', not 'none' on line 3 (Line: /dev/sda2       none            none    sw              0       0)
 - [error] Unknown filesystem type 'unknown' on line 4 (Line: /dev/sda3       /mnt            unknown defaults        0       2)
